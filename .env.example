# Settings for running dx.server on this machine (make dev). Copy to .env;
# `make setup` does that. In Docker, infra.dx sets these instead.
#
# The defaults work when the DX repos sit side by side (see infra.dx's README)
# with MongoDB and Redis on this machine; `make native` in infra.dx starts them.

PORT=4200
ENV_TYPE=dev
LOG_LEVEL=info

# MongoDB and Redis on this machine
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_DB=the-data-explorer-db
MONGO_USERNAME=
MONGO_PASSWORD=
MONGO_AUTH_SOURCE=
REDIS_HOST=localhost
REDIS_PASSWORD=

# Where the server calls dx.backend and general-ai-api (src/config/services.ts).
DX_BACKEND_URL=http://localhost:4004
AIAPI_URL=http://localhost:5000

# dx.backend's folder, next to this repo: uploads go to its staging/ folder and
# charts render from its parsed files.
DX_BACKEND_DIR=../dx.backend/
PARSED_DATA_FILES_PATH=../dx.backend/parsed-data-files/

# Auth0
AUTH0_DOMAIN='your auth0 tenant app domain'
AUTH0_AUDIENCE='your auth0 tenant app audience'
AUTH0_TOKEN_URL='your auth0 token url'
AUTH0_MGMT_CLIENT='your auth0 management client id'
AUTH0_MGMT_SECRET='your auth0 management client secret'

# Stripe
PRICING_ACTIVE=false
STRIPE_API_KEY='your stripe api key'
STRIPE_PRODUCT_FREE_MONTHLY_PRICE_ID='your stripe free product monthly price id'
STRIPE_PRODUCT_FREE_ANNUALLY_PRICE_ID='your stripe free product annually price id'
STRIPE_PRODUCT_PRO_MONTHLY_PRICE_ID='your stripe pro product monthly price id'
STRIPE_PRODUCT_PRO_ANNUALLY_PRICE_ID='your stripe pro product annually price id'
STRIPE_PRODUCT_TEAM_MONTHLY_PRICE_ID='your stripe team product monthly price id'
STRIPE_PRODUCT_TEAM_ANNUALLY_PRICE_ID='your stripe team product annually price id'
STRIPE_PRODUCT_ENTERPRISE_MONTHLY_PRICE_ID='your stripe enterprise product monthly price id'
STRIPE_PRODUCT_ENTERPRISE_ANNUALLY_PRICE_ID='your stripe enterprise product annually price id'

# Media search
GOOGLE_API_KEY='Google Cloud API key with YouTube API access'
SHUTTERSTOCK_API_TOKEN='shutterstock api token'
UNSPLASH_ACCESS_KEY='unsplash access key'
VIMEO_ACCESS_TOKEN='vimeo access token'

INTERCOM_SECRET_KEY='from intercom'
INTERCOM_ACCESS_TOKEN='from intercom'

# Google Calendar: path to a service account key file. Empty turns it off.
GOOGLE_CALENDAR_ID=
GOOGLE_CALENDAR_SEARCH_QUERY=
GOOGLE_CALENDAR_SUBJECT=
GOOGLE_CALENDAR_KEY_FILE=
